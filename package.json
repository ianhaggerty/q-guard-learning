{
  "name": "pixel-map-lab",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Raster map editor and exploration game",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "apps/web",
    "apps/play",
    "services/api",
    "services/room-server"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "start": "node scripts/dev.js",
    "serve": "node scripts/serve.js",
    "build:web": "npm run build -w apps/web",
    "build:play": "npm run build -w apps/play",
    "test:python": "node scripts/test-python.js"
  }
}
